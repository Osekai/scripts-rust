  "query": "\nSELECT user_id, description, awarded_at, name\nFROM\n    (SELECT\n        `Badge_ID` AS badge_id, \n        `User_ID` AS user_id, \n        `Description` AS description, \n        `Date_Awarded` AS awarded_at \n    FROM `Badges_Users`) AS u\n    JOIN\n    (SELECT `ID` AS badge_id, `Name` AS name FROM `Badges_Data`) AS n\n    USING (badge_id)",
